{
  "name": "tiktok-live-automation",
  "version": "1.0.0",
  "description": "TikTok LIVE Sales Automation for Children's Clothing Store",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "test:admin": "npm --prefix admin run test",
    "test:admin:coverage": "npm --prefix admin run test:coverage",
    "test:pos": "npm --prefix pos run test",
    "test:pos:coverage": "npm --prefix pos run test:coverage",
    "pos:migrate": "tsx src/pos/migrate.ts",
    "pos:seed": "tsx src/pos/seed.ts",
    "docker:build": "docker build -t tiktok-live-automation .",
    "docker:run": "docker run -it --env-file .env tiktok-live-automation",
    "docker:deps": "docker compose up -d postgres redis"
  },
  "keywords": [
    "tiktok",
    "live",
    "automation",
    "ecommerce",
    "telegram",
    "novaposhta"
  ],
  "author": "Serhii Merenkov / Technologies LLC",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "axios": "^1.6.5",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.7.0",
    "dotenv": "^16.3.1",
    "fastify": "^5.8.5",
    "ioredis": "^5.3.2",
    "node-cron": "^3.0.3",
    "pg": "^8.21.0",
    "telegraf": "^4.15.0",
    "tiktok-live-connector": "^2.3.0-beta1",
    "winston": "^3.11.0",
    "ws": "^8.21.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.2",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/ui": "^4.1.6",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
