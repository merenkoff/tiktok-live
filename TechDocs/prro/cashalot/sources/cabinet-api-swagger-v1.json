  "components": {
    "schemas": {
      "ApiImportItem": {
        "required": [
          "name",
          "sellPrice",
          "unitType",
          "vendorcode"
        ],
        "type": "object",
        "properties": {
          "vendorcode": {
            "minLength": 1,
            "type": "string",
            "description": "Артикул",
            "default": ""
          },
          "name": {
            "minLength": 1,
            "type": "string",
            "description": "Найменування",
            "default": ""
          },
          "barcode": {
            "type": "string",
            "description": "Штрихкод виробника",
            "default": "",
            "nullable": true
          },
          "groupName": {
            "type": "string",
            "description": "Група",
            "default": "",
            "nullable": true
          },
          "type": {
            "type": "string",
            "description": "Тип (1 - товар, 2 - послуга, 3 - послуга/операція видачі)",
            "default": "",
            "nullable": true
          },
          "unitType": {
            "minLength": 1,
            "type": "string",
            "description": "Одиниця виміру",
            "default": ""
          },
          "uktzedCode": {
            "type": "string",
            "description": "Код УКТЗЕД",
            "default": "",
            "nullable": true
          },
          "dkppCode": {
            "type": "string",
            "description": "Код за ДКПП",
            "default": "",
            "nullable": true
          },
          "pdvAmount": {
            "type": "string",
            "description": "Ставка ПДВ",
            "default": "",
            "nullable": true
          },
          "pdvLetter": {
            "type": "string",
            "description": "Літера ставки ПДВ",
            "default": "",
            "nullable": true
          },
          "exciseAmount": {
            "type": "string",
            "description": "Ставка акцизу",
            "default": "",
            "nullable": true
          },
          "exciseLetter": {
            "type": "string",
            "description": "Літера ставки акцизу",
            "default": "",
            "nullable": true
          },
          "pfAmount": {
            "type": "string",
            "description": "Ставка ПФ",
            "default": "",
            "nullable": true
          },
          "pfLetter": {
            "type": "string",
            "description": "Літера ставки ПФ",
            "default": "",
            "nullable": true
          },
          "sellPrice": {
            "minLength": 1,
            "type": "string",
            "description": "Ціна продажу",
            "default": ""
          },
          "tradeMargin": {
            "type": "string",
            "description": "Націнка",
            "default": "",
            "nullable": true
          },
          "buyPrice": {
            "type": "string",
            "description": "Ціна придбання",
            "default": "",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ApiImportModelView": {
        "required": [
          "edrPou",
          "mode",
          "nomenclatures"
        ],
        "type": "object",
        "properties": {
          "edrPou": {
            "minLength": 1,
            "type": "string",
            "description": "ЄДРПОУ/ІПН організації"
          },
          "mode": {
            "$ref": "#/components/schemas/ImportMode"
          },
          "nomenclatures": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiImportItem"
            },
            "description": "Масив даних номенклатури"
          }
        },
        "additionalProperties": false
      },
      "AuthorizationRequest": {
        "required": [
          "edrpou",
          "hash"
        ],
        "type": "object",
        "properties": {
          "edrpou": {
            "minLength": 1,
            "type": "string",
            "description": "ЄДРПОУ організації"
          },
          "hash": {
            "minLength": 1,
            "type": "string",
            "description": "Значення хешу обчислюється на основі набору даних \"Дати запиту\" (YYYYMMDD) та унікального значення \"Публічного ключа\", зашифрованого алгоритмом SHA-256 з використанням \"Приватного ключа\".\r\n\r\nЛанцюжок \"Дата запиту\" та \"Публічний ключ\" вказується без пробілів (YYYYMMDDAPIkey). Значення API key публічного та приватного ключів генерується у Кабінеті Cashalot, розділ \"Мій бізнес\" - \"Налаштування\" - \"API KEY облікових систем\""
          }
        },
        "additionalProperties": false,
        "description": "Запит на авторизацію"
      },
      "AuthorizationResponse": {
        "type": "object",
        "properties": {
          "resultCode": {
            "type": "integer",
            "description": "0 - запит виконано успішно\r\n\r\n1 - В Кабінеті Cashalot не знайдено організацію по вказаному ЕДРПОУ\r\n\r\n2 - Некоректний Хеш\r\n\r\n3 - Не знайдено користувача з вказаним API key\r\n\r\n99 - Помилка обробки запиту",
            "format": "int32"
          },
          "resultMessage": {
            "type": "string",
            "description": "Повідомлення в котрому буде вказано причину невдачі авторизації",
            "nullable": true
          },
          "token": {
            "type": "string",
            "description": " У разі успішного запиту у відповідь надсилається токен авторизації, який використовується вподальшому у всіх запитах. \r\n \r\nТокен має термін дії та деактивується через 15 хвилин після останнього запиту\"",
            "format": "uuid"
          }
        },
        "additionalProperties": false,
        "description": ""
      },
      "EPaymentType": {
        "enum": [
          0,
          1
        ],
        "type": "integer",
        "format": "int32"
      },
      "ETaxType": {
        "enum": [
          0,
          1
        ],
        "type": "integer",
        "format": "int32"
      },
      "FullInfo": {
        "type": "object",
        "properties": {
          "dfsNumber": {
            "type": "string",
            "nullable": true
          },
          "dateBeg": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-21T14:58:29Z"
          },
          "dateEnd": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": "2026-10-21T14:58:29Z"
          },
          "firmName": {
            "type": "string",
            "nullable": true
          },
          "businessunitName": {
            "type": "string",
            "nullable": true
          },
          "businessUnitAddress": {
            "type": "string",
            "nullable": true
          },
          "edrpou": {
            "type": "string",
            "nullable": true
          },
          "inn": {
            "type": "string",
            "nullable": true
          },
          "fullName": {
            "type": "string",
            "nullable": true
          },
          "localNumber": {
            "type": "string",
            "nullable": true
          },
          "cashierName": {
            "type": "string",
            "nullable": true
          },
          "rroFiscalNumber": {
            "type": "integer",
            "format": "int64"
          },
          "receipt": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Receipt"
            },
            "nullable": true
          },
          "report": {
            "$ref": "#/components/schemas/Report"
          }
        },
        "additionalProperties": false
      },
      "FullInfoResposeArrayResult": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FullInfo"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "IApiImportJobResult": {
        "type": "object",
        "properties": {
          "isError": {
            "type": "boolean",
            "description": "Операція імпорту не виконана"
          },
          "isCompleted": {
            "type": "boolean",
            "description": "Операція імпорту завершена"
          },
          "recordCount": {
            "type": "integer",
            "description": "Кількість оброблених записів",
            "format": "int32"
          },
          "create": {
            "type": "integer",
            "description": "Кількість створених записів номенклатури",
            "format": "int32"
          },
          "update": {
            "type": "integer",
            "description": "Кількість відредагованих записів номенклатури",
            "format": "int32"
          },
          "bad": {
            "type": "integer",
            "description": "Кількість записів з помилками валідації",
            "format": "int32"
          },
          "validationMessages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Повідомлення з причиною помилки валідації",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "IApiImportJobResultResposeArrayResult": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IApiImportJobResult"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ImportMode": {
        "enum": [
          0,
          1,
          2
