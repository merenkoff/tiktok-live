# TikTok
TIKTOK_USERNAME=your_tiktok_username

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=your_telegram_channel_id

# Database (PostgreSQL)
# Local dev with docker compose: DB_HOST=localhost, DB_PORT=5433
# Railway: add Postgres plugin and set DATABASE_URL=${{Postgres.DATABASE_URL}}
#   — or set DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD from Postgres service refs
DB_HOST=localhost
DB_PORT=5433
DB_NAME=tiktok_live
DB_USER=postgres
DB_PASSWORD=postgres
# DATABASE_URL=
# DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# API Server
API_PORT=3000
NODE_ENV=development

# Nova Poshta API
NOVAPOSHTA_API_KEY=your_novaposhta_key
NOVAPOSHTA_MERCHANT_NAME=your_merchant_name

# Logging
LOG_LEVEL=debug

# Business Rules
RESERVATION_TIMEOUT_MINUTES=5
PAYMENT_CONFIRMATION_TIMEOUT_MINUTES=10
