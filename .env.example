# TikTok LIVE / Telegram / Nova Poshta are NOT configured here.
# They are per-seller settings in the `user_settings` table, edited in the LIVE
# admin Settings page (go.the-live.shop → Налаштування) and read at session
# start. A single process serves many sellers, so a process-wide TIKTOK_USERNAME
# / TELEGRAM_BOT_TOKEN / NOVAPOSHTA_API_KEY cannot be correct for all of them.

# Database (PostgreSQL)
# Local dev with docker compose: DB_HOST=localhost, DB_PORT=5433
# Railway: add Postgres plugin and set DATABASE_URL=${{Postgres.DATABASE_URL}}
#   — or set DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD from Postgres service refs
DB_HOST=localhost
DB_PORT=5433
DB_NAME=tiktok_live
DB_USER=postgres
DB_PASSWORD=postgres
# DATABASE_URL=
# DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# API Server
API_PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=debug

# POS (clothing store) — same Postgres, separate tables pos_*
# npm run pos:migrate && npm run pos:seed
# Frontend: cd pos && npm run dev  (http://localhost:3002)
# Product photos: data/pos-uploads → /pos-uploads/*
# Railway setup: TechDocs/RAILWAY_POS.md
# Demo: owner@demo.shop / owner123 | store slug demo | seller PIN 1234
#
# Railway / multi-domain CORS (comma-separated POS + admin origins):
# CORS_ORIGINS=https://pos.example.com,https://admin.example.com
# Desktop cashier (Tauri) origins https://tauri.localhost are hardcoded in src/api.ts
# Prefer DATABASE_URL on Railway; optional DB_SSL=true
#
# Dynamic QR payment (Opendatabot IBAN Payment API, https://iban.opendatabot.ua)
# Only needed when a store uses qr_payment_mode = 'dynamic'. ~0.42 UAH per invoice.
# Public test key works for dev (client name is "public"); real credentials: https://opendatabot.ua/registration
# OPENDATABOT_QR_KEY=z3B2lnWiA7drCbopgWTIjPcDzmHuICzk0rUQrcSFCWs=
# OPENDATABOT_QR_NAME=public
#
# ПРРО fiscalisation (TechDocs/POS_FISCAL_PRRO.md)
# Encrypts each store's provider credentials at rest (pos_fiscal_settings).
# 32 bytes, base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it a store cannot save credentials (503) and cannot fiscalise — never
# stored in plaintext. Losing/rotating it means owners re-enter their licence keys.
# POS_SECRETS_KEY=
#
# ПРРО offline dry run (TechDocs/POS_FISCAL_OFFLINE.md phase 0): credentials of a
# TEST Checkbox register for `npm run fiscal:sandbox:offline`. Never a real one.
# CHECKBOX_SANDBOX_LICENSE_KEY=
# CHECKBOX_SANDBOX_PIN=

# Super admin (TechDocs/POS_SUPER_ADMIN.md) — `/super` in the POS web: overview of
# every store + edit its enabled_modules / module_remotes, re-point a module
# release URL across stores. Whoever knows this password configures ALL stores.
# ≥ 12 characters; unset (or shorter) disables the page (503). Rotate by changing
# it + redeploy — every issued token dies with it.
# POS_SUPER_PASSWORD=
