# TikTok LIVE / Telegram / Nova Poshta are NOT configured here.
# They are per-seller settings in the `user_settings` table, edited in the LIVE
# admin Settings page (go.the-live.shop → Налаштування) and read at session
# start. A single process serves many sellers, so a process-wide TIKTOK_USERNAME
# / TELEGRAM_BOT_TOKEN / NOVAPOSHTA_API_KEY cannot be correct for all of them.

# Database (PostgreSQL)
# Local dev with docker compose: DB_HOST=localhost, DB_PORT=5433
# Railway: add Postgres plugin and set DATABASE_URL=${{Postgres.DATABASE_URL}}
#   — or set DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD from Postgres service refs
DB_HOST=localhost
DB_PORT=5433
DB_NAME=tiktok_live
DB_USER=postgres
DB_PASSWORD=postgres
# DATABASE_URL=
# DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# API Server
API_PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=debug

# POS (clothing store) — same Postgres, separate tables pos_*
# npm run pos:migrate && npm run pos:seed
# Frontend: cd pos && npm run dev  (http://localhost:3002)
# Product photos: data/pos-uploads → /pos-uploads/*
# Railway setup: TechDocs/RAILWAY_POS.md
# Demo: owner@demo.shop / owner123 | store slug demo | seller PIN 1234
#
# Railway / multi-domain CORS (comma-separated POS + admin origins):
# CORS_ORIGINS=https://pos.example.com,https://admin.example.com
# Desktop cashier (Tauri) origins https://tauri.localhost are hardcoded in src/api.ts
# Prefer DATABASE_URL on Railway; optional DB_SSL=true
#
# Dynamic QR payment (Opendatabot IBAN Payment API, https://iban.opendatabot.ua)
# Only needed when a store uses qr_payment_mode = 'dynamic'. ~0.42 UAH per invoice.
# Public test key works for dev (client name is "public"); real credentials: https://opendatabot.ua/registration
# OPENDATABOT_QR_KEY=z3B2lnWiA7drCbopgWTIjPcDzmHuICzk0rUQrcSFCWs=
# OPENDATABOT_QR_NAME=public
#
# ПРРО fiscalisation (TechDocs/prro/POS_FISCAL_PRRO.md)
# Encrypts each store's provider credentials at rest (pos_fiscal_settings).
# 32 bytes, base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it a store cannot save credentials (503) and cannot fiscalise — never
# stored in plaintext. Losing/rotating it means owners re-enter their licence keys.
# POS_SECRETS_KEY=
#
# ПРРО offline dry run (TechDocs/prro/POS_FISCAL_OFFLINE.md phase 0): credentials of a
# TEST Checkbox register for `npm run fiscal:sandbox:offline`. Never a real one.
# CHECKBOX_SANDBOX_LICENSE_KEY=
# CHECKBOX_SANDBOX_PIN=
#
# ПРРО Cashalot probes (TechDocs/prro/cashalot/POS_FISCAL_CASHALOT.md §4.5, phase CA3):
# `npm run fiscal:sandbox:cashalot` against a REAL register in TEST mode — Cashalot
# has no sandbox. From the cabinet: «Налаштування → Інтеграція з WEB API →
# Управління касирами» (KeyGuid, PIN) and the register's fiscal number.
# CASHALOT_SANDBOX_KEY_GUID=
# CASHALOT_SANDBOX_KEY_PIN=
# CASHALOT_SANDBOX_NUM_FISCAL=

# Super admin (TechDocs/POS_SUPER_ADMIN.md) — `/super` in the POS web: overview of
# every store + edit its enabled_modules / module_remotes, re-point a module
# release URL across stores. Whoever knows this password configures ALL stores.
# ≥ 12 characters; unset (or shorter) disables the page (503). Rotate by changing
# it + redeploy — every issued token dies with it.
# POS_SUPER_PASSWORD=

# Public base URL printed into the guest QR menu's QR codes (TechDocs/POS_QR_MENU.md).
# Defaults to https://the-live.shop; set it only when the menu lives elsewhere (local dev).
# PUBLIC_BASE_URL=http://localhost:3000

# Licence (TechDocs/POS_LICENSING.md, phase 2) — OPTIONAL and DISCLOSED.
# LICENSE_KEY is the signed activation token the author issues to a licensee.
# On boot and once a day the backend verifies it locally (Ed25519) and sends a
# licence-COMPLIANCE ping to LICENSE_SERVER_URL carrying ONLY: the token, a
# random per-install id, the POS API version and the origin this copy runs on
# (Railway's own RAILWAY_PUBLIC_DOMAIN, else the first origin of CORS_ORIGINS —
# never PUBLIC_BASE_URL, which is for the guest menu; the receiver also keeps
# the address the ping came from) — NO user
# activity, catalogue or personal data. The ping is best-effort and the POS
# keeps working regardless: a missing, invalid or expired key, or an
# unreachable server, only changes what `GET /api/pos/license/status` reports
# and what is logged. It is NOT a kill switch and never disables a lawfully-run
# copy (OwnNet 1.1 §1.150). Leave both unset to run with status 'unlicensed'.
# LICENSE_KEY=
# LICENSE_SERVER_URL=https://the-live.shop
#
# Licence gate for the author's OWN update feed (phase 2D). Only meaningful on
# the author's the-live.shop deployment, which serves GET /api/updates/latest.json
# (the Tauri cashier's updater points there). Default (unset / not 'on'): the feed
# is a transparent proxy of the upstream below — identical to going straight to
# GitHub, no behaviour change. Set to 'on' to require a valid licence token
# (X-License-Key header) for updates: an unlicensed copy of an OFFICIAL build then
# stops getting updates, while its POS keeps running. Not a kill switch (§1.145).
# LICENSE_UPDATE_GATE=on
# Where the feed proxies from (defaults to the project's GitHub latest.json):
# LICENSE_UPDATE_UPSTREAM=https://github.com/merenkoff/tiktok-live/releases/latest/download/latest.json
#
# Licence gate for ONLINE-MODULE delivery (TechDocs/POS_OPENCORE.md §8). The
# author can repoint stores' module_remotes at the-live.shop/api/modules/<id>/
# <version>/<file>; that route proxies the signed bundle from jsdelivr. Default
# (unset / not 'on'): transparent proxy, no behaviour change. Set to 'on' to
# require a valid licence token (X-License-Key) for the online modules — an
# unlicensed copy keeps the open platform (clothing) but loses them. Not a kill
# switch. Like the update gate, it only bites per-deployment once the desktop
# forwards its token (2D-B).
# LICENSE_MODULE_GATE=on
# Upstream the module route proxies from (owner/repo on jsdelivr's gh CDN):
# LICENSE_MODULE_GH=merenkoff/tiktok-live
# LICENSE_MODULE_UPSTREAM_BASE=https://cdn.jsdelivr.net/gh
